{
  "name": "@wirecat/cli-messaging",
  "version": "0.217.0",
  "description": "The messenger-neutral half of a messaging CLI: domain model, message locators, rendering, name resolution, the SQLite seam, the command skeleton and shared read commands, the send guard, run records and the message store",
  "license": "Apache-2.0",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/cli-messaging.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.20.0",
  "files": [
    "dist",
    "parity.json",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "docs/search/recipes.json"
  ],
  "exports": {
    "./documents": {
      "types": "./dist/documents.d.ts",
      "default": "./dist/documents.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite-runtime": {
      "types": "./dist/sqlite-runtime.d.ts",
      "default": "./dist/sqlite-runtime.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./sends": {
      "types": "./dist/sends/index.d.ts",
      "default": "./dist/sends/index.js"
    },
    "./speech": {
      "types": "./dist/speech/index.d.ts",
      "default": "./dist/speech/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./background": {
      "types": "./dist/background/index.d.ts",
      "default": "./dist/background/index.js"
    },
    "./parity": {
      "types": "./dist/parity/index.d.ts",
      "default": "./dist/parity/index.js"
    },
    "./testing": {
      "types": "./dist/kit/index.d.ts",
      "default": "./dist/kit/index.js"
    },
    "./parity.json": "./parity.json",
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "default": "./dist/models/index.js"
    },
    "./skill-validation": {
      "types": "./dist/skills/validate.d.ts",
      "import": "./dist/skills/validate.js"
    }
  },
  "scripts": {
    "build": "tsc --build && node scripts/bundle-drizzle.ts && node scripts/copy-snowball.ts && node scripts/copy-chart-fonts.ts",
    "check:dist": "node scripts/check-dist.ts",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:bundle": "node scripts/bundle-migrations.ts",
    "docs:check": "pnpm build && node --experimental-strip-types scripts/docs-check.ts && node scripts/search-docs.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:slow": "vitest run --reporter=json --outputFile=coverage/tests.json >/dev/null; cli-dev slow-tests",
    "smoke:bun": "bun run scripts/smoke.ts",
    "prepare": "lefthook install || true",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "prepublishOnly": "pnpm build",
    "parity:seed": "tsc --build && node --experimental-strip-types scripts/parity-seed.ts",
    "parity:render": "node --experimental-strip-types scripts/parity-render.ts",
    "parity:audit": "tsc --build && node --experimental-strip-types scripts/parity-audit.ts",
    "search:docs": "pnpm build && node scripts/search-docs.ts",
    "check:agent-process": "pnpm build && node --experimental-strip-types scripts/check-agent-process.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@bomb.sh/tab": "0.0.22",
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@resvg/resvg-js": "2.6.2",
    "@valibot/to-json-schema": "1.8.0",
    "@wirecat/cli-meetings": "0.2.1",
    "@wirecat/cli-messaging-onnx": "1.0.0",
    "@wirecat/cli-messaging-sqlite": "1.0.0",
    "@wirecat/cli-tasks": "0.2.1",
    "@xmldom/xmldom": "0.9.12",
    "chardet": "2.2.0",
    "echarts": "6.1.0",
    "fflate": "0.8.3",
    "iconv-lite": "0.7.3",
    "image-size": "2.0.4",
    "liquidjs": "10.30.0",
    "lossless-json": "4.3.0",
    "ogg-opus-decoder": "1.7.5",
    "qrcode-generator": "2.0.4",
    "sherpa-onnx": "1.13.8",
    "string-width": "8.3.0",
    "valibot": "1.5.0",
    "wrap-ansi": "10.0.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@modelcontextprotocol/client": "2.2.0",
    "@napi-rs/canvas": "1.0.10",
    "@types/node": "^22.20.4",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "^5.0.2",
    "@wirecat/cli-core": "0.19.0",
    "cli-messaging-0.13": "npm:@leemour/cli-messaging@0.13.0",
    "cli-messaging-0.27": "npm:@leemour/cli-messaging@0.27.0",
    "cli-messaging-0.49": "npm:@leemour/cli-messaging@0.49.0",
    "commander": "15.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "esbuild": "0.25.12",
    "exceljs": "4.4.0",
    "jsqr": "1.4.0",
    "lefthook": "^2.1.8",
    "mammoth": "1.13.0",
    "pngjs": "7.0.0",
    "typescript": "^7.0.2",
    "unpdf": "1.8.1",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@napi-rs/canvas": ">=0.1.69 <2",
    "@wirecat/cli-core": ">=0.19.0 <0.20.0",
    "commander": ">=15",
    "mammoth": ">=1.8.0 <2",
    "unpdf": ">=1.0.0 <2"
  },
  "bin": {
    "cli-messaging-parity": "dist/parity/bin.js"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "unpdf": {
      "optional": true
    }
  }
}
